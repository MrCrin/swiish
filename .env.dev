# See .env.example and README.md#configuration for documentation.

JWT_SECRET=change-this-secret-in-production

NODE_ENV=development

DEMO_MODE=true

PORT=3000

JWT_EXPIRES_IN=1h

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8095
 
MAX_FILE_SIZE=5242880

FORCE_HTTPS=false

APP_URL=http://localhost:3000

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM=

